---
import Card "../../components/Card.orbit"

if params.Slug == "nope" {
	return orbit.ErrNotFound
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>Post {params.Slug}</title>
  </head>
  <body>
    <Card title={params.Slug}>
      <p>slug={ctx.Param("slug")}</p>
    </Card>
  </body>
</html>
