---
import (
	Card "./Card.orbit"
	Counter "./Counter.orbit"
	Later "./Later.orbit"
)

type Props struct {
	Title    string
	Featured bool
}
---
<section class:list={"rich", "featured": props.Featured}>
  <Card title={props.Title} featured={props.Featured}>
    <Counter client:visible />
    <Later server:defer id={7}><p slot="fallback">Loading…</p></Later>
  </Card>
</section>
