{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Injected into Markdown: ```lyr fenced code blocks highlight as Lyr, the --- frontmatter as Go.",
  "scopeName": "text.html.markdown.lyr",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    { "include": "#fenced-code-block-lyr" }
  ],
  "repository": {
    "fenced-code-block-lyr": {
      "comment": "Same shape as the fenced blocks of VS Code's Markdown grammar. Inside the block a --- line opens the frontmatter wherever it is: a fence has no \\A to anchor it to.",
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(lyr)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.lyr",
          "patterns": [
            { "include": "#frontmatter" },
            { "include": "source.lyr#template" }
          ]
        }
      ]
    },
    "frontmatter": {
      "name": "meta.frontmatter.lyr",
      "begin": "(^|\\G)\\s*(---)\\s*$",
      "end": "^\\s*(---)\\s*$",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.frontmatter.begin.lyr" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.frontmatter.end.lyr" }
      },
      "contentName": "meta.embedded.block.go",
      "patterns": [
        { "include": "source.go" },
        { "include": "source.lyr#keep" }
      ]
    }
  }
}
