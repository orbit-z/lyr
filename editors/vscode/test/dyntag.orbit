---
link := props.Attrs.Has("href")
Tag := orbit.Cond(link, "a", "button")
Wrap := orbit.Cond(props.Wrapped, "div", orbit.Fragment)
---
<Tag {...props.Attrs} type={orbit.If(!link, "button")} class="btn"><slot /></Tag>
<Wrap class="w"><label>x</label></Wrap>
<html {...theme.Attributes(choices, store)} lang="en"></html>
