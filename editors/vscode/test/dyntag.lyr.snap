>link := props.Attrs.Has("href")
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.lyr meta.frontmatter.lyr meta.embedded.block.go
>Tag := lyr.Cond(link, "a", "button")
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.lyr meta.frontmatter.lyr meta.embedded.block.go
>Wrap := lyr.Cond(props.Wrapped, "div", lyr.Fragment)
#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ source.lyr meta.frontmatter.lyr meta.embedded.block.go
>---
#^^^ source.lyr meta.frontmatter.lyr punctuation.definition.frontmatter.end.lyr
><Tag {...props.Attrs} type={lyr.If(!link, "button")} class="btn"><slot /></Tag>
