---
import (
	Card "../components/Card.orbit"
	"example.com/blog/internal/posts"
	"strings"
)

type Props struct {
	Title string
	Count int
}

list, err := posts.All()
if err != nil {
	return err
}
title := strings.ToUpper(props.Title) // shown in the header
---
<Card title={title} count={len(list)} />
