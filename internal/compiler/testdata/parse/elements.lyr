  <Fragment slot="actions"><a href="/rss.xml">RSS</a></Fragment>
  <Fragment set:html={body} />
  <textarea name="t">{value} and <i>not markup</i></textarea>
  <script>
    const o = { a: 1 }; if (a < b && c > d) { console.log("</div>") }
