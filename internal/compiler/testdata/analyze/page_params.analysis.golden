info src/pages/blog/[post-id]/[...rest].orbit page route="/blog/[post-id]/[...rest]"
implicit orbit: none
stmt @4-46 "title := params.PostID + \"/\" + params.Rest"
echo [title]
terminating false
props declared=false listable=true span=@0-0
param PostID [post-id] rest=false
param Rest [rest] rest=true
