---
import (
	"strings"
	"strconv"
)

type Item struct{ Name string }

type Props struct{ Items []Item }

if true {
	props := 1
	_ = props
}
strconv := "shadow"
---
{for _, props := range props.Items}
  <p>{strings.ToUpper(props.Name)}{strconv}</p>
{/for}
{for _, orbit := range []int{1}}{orbit}{/for}
{for _, ctx := range []int{1}}<Self items={nil} />{ctx}{/for}
