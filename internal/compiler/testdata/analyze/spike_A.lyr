---
import (
    "strings"
    B "./B.lyr"
)

type Item struct {
    Name  string
    Count int
}

func (i Item) Title() string { return strings.ToUpper(i.Name) }

type Props struct {
    Item  Item
    Depth int
}

func label(n int) string { return "A" + strings.Repeat(">", n) }

title := label(props.Depth)
unused := 42
---
<div class="a">
  <h2>{title} {props.Item.Title()}</h2>
  {if props.Item.Count > 0}
    <Self item={Item{Name: props.Item.Name, Count: props.Item.Count - 1}} depth={props.Depth} />
  {/if}
  {if props.Depth < 4}
    <B depth={props.Depth + 1} tag={B.Tag{Text: title}} />
  {/if}
</div>
