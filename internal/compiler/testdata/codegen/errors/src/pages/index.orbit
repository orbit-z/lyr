---
import Card "../components/Card.orbit"
import Bare "../components/Bare.orbit"
import Embed "../components/Embed.orbit"
import Gone "../components/Gone.orbit"
import Unused "../components/Card.orbit"
---
<Crad title="x" />
<Card psot={1} title="ok" is-open />
<Card server:defer title="d" />
<Card client:idle title="i" />
<Card client:visible title="v" />
<Card client:load title="l" />
<Bare x="1" />
<Embed name="e" extra={2} />
<Gone a={1} />
<Self foo="x" />
