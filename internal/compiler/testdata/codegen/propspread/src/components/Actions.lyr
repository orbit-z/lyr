---
type Props struct {
	Slug, StartHref string
	Mine            bool
	QuestionID      string
	Class           string
	Note            lyr.Opt[string]
	Attrs           lyr.RestAttrs
}
---
<div class={props.Class} id={props.QuestionID} data-slug={props.Slug} data-start={props.StartHref} data-mine={props.Mine} {...props.Attrs}>{props.Note}</div>
