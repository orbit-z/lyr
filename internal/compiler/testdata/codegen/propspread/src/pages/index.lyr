---
import Actions "../components/Actions.lyr"
import Cached "../components/Cached.lyr"
import Card "../components/Card.lyr"
import Fwd "../components/Fwd.lyr"
import Tree "../components/Tree.lyr"
import "example.com/blog/internal/cards"

actions := Actions.Props{Slug: "s", StartHref: "/start", Mine: true}
ref := cards.Ref{Slug: "r", Version: "v2"}
opts := cards.Options{Credits: true, Lines: 3}
var nilRef *cards.Ref
setRef := &cards.Ref{Slug: "p", Version: "v9"}
extra := cards.Extra{Note: "noted"}
attrs := lyr.Attrs{"data-a": "1"}
---
<main>
{for _, n := range []int{1, 2}}
	<Card {...cards.Counted(n)} />
{/for}
<p>calls {cards.Calls}</p>
<Actions {...actions} questionID="q-top" class="mt-5" />
<Actions {...extra} {...attrs} slug="e" data-b="2" />
<Cached {...ref} {...opts} />
<Cached {...nilRef} {...opts} />
<Cached {...setRef} />
<Tree depth={2} label="t" />
<Fwd slug="f" data-y="3" />
<Card {...cards.Of(5)} server:defer />
<Card {...cards.Of(6)} server:concurrent />
<Card {...cards.Of(7)} title="seven" client:visible />
</main>
