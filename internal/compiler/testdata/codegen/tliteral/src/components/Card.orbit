---
type Slug string

type Props struct {
	Title string
	Slug  Slug
	Any   any
	Href  orbit.URL
	Body  orbit.HTML
	Style orbit.CSS
	Class string
	Attrs orbit.RestAttrs
}
---
<div class={props.Class} style={props.Style}><a href={props.Href}>{props.Title}</a> {props.Slug} {props.Any}<span set:html={props.Body}></span><p {...props.Attrs}></p></div>
