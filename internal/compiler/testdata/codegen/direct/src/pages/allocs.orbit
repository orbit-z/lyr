---
import Card "../components/Card.orbit"
import Frame "../components/Frame.orbit"
import Tree "../components/Tree.orbit"

type item struct {
	Title string
	N     int
}

items := [2]item{{"a", 1}, {"b", 2}}
---
<main>
  {for _, it := range items}
    <Card title={it.Title}>
      <p>{it.Title}: {it.N}</p>
      <small slot="footer">#{it.N}</small>
    </Card>
    <Frame title={it.Title}>{it.Title}!</Frame>
  {/for}
  <Tree depth={2}><b>{items[0].Title}</b></Tree>
</main>
