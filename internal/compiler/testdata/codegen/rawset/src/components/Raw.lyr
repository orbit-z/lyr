---
import "github.com/orbit-z/lyr"

theme := lyr.HTML(`document.documentElement.dataset.theme = localStorage.theme || "dark";`)
css := lyr.HTML(`body > p { color: red }`)
text := `a < b && "c"`
---
<script is:inline set:html={theme}></script>
<script set:html={theme}></script>
<style is:inline set:html={css}></style>
<style set:html={css}></style>
<script is:inline set:text={text}></script>
<style set:text={text}></style>
<style is:inline>p { margin: 0 }</style>
