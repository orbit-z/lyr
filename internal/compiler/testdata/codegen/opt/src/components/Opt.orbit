---
type Props struct {
	On bool
	S  string
}

type Slug string
type Flag bool

// A type defined over an Opt is a new struct type: not lowered.
type MyOpt orbit.Opt[string]

o := orbit.Some("a&\"b")
none := orbit.None[string]()
u := orbit.Some(orbit.URL("javascript:ok()"))
bad := orbit.Some(" javascript:x")
i := orbit.Some(-3)
f := orbit.Some(float32(0.1))
b := orbit.Some(false)
bt := orbit.Some(true)
fl := orbit.Some(Flag(true))
h := orbit.Some(orbit.HTML("<b>h</b>"))
css := orbit.Some(orbit.CSS("color: red"))
j := orbit.Some(orbit.JSON(map[string]int{"a": 1}))
sl := orbit.Some(Slug("s&t"))
nest := orbit.Some(orbit.Some("in"))
nestNone := orbit.Some(orbit.None[string]())
anyo := orbit.Some[any](7)
cls := orbit.Some("x  y")
clss := orbit.Some([]string{"p", "q"})
var mine MyOpt
---
<a title={o} rel={none} href={u} src={bad} id={orbit.NonZero(props.S)} tabindex={i} data-f={f} aria-pressed={b} hidden={bt} disabled={b} data-flag={fl} data-h={h} style={css} data-j={j} data-slug={sl} data-nest={nest} data-nn={nestNone} data-any={anyo}>a</a>
<p>{o}|{none}|{i}|{f}|{b}|{h}|{sl}|{nest}|{nestNone}|{anyo}|{orbit.NonZero(props.S)}|{orbit.Some(props.S)}|{(o) /* c */}</p>
<p set:text={o}></p>
<p class:list={"k", cls, clss, none}>c</p>
<p class="z" class:list={cls}>d</p><p class={none}>f</p>
{for k := range 3}
  <i data-k={orbit.If(k != 1, k)} title={orbit.NonZero(k)}>{orbit.NonZero(k)}</i>
{/for}
<p title={mine}>defined</p>
<p style={orbit.If(props.On, css.Or(""))}>s</p>
