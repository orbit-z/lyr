---
import Card "../components/Card.lyr"

type Cls string

type Tags []string

hidden, pairs := true, false
extra := "  rounded\tborder "
base := []string{"grid", "", "gap-2"}
var named Cls = "named"
tags := Tags{"t1", "t2"}
empty := ""
---
<div class:list={"appearance-none", "rounded-input  border", "hidden": hidden, "flex": pairs}>static and conds</div>
<div class:list={"block", extra}>static then dynamic</div>
<div class:list={base, "x"}>dynamic first</div>
<div class:list={"active": pairs}>empty: no attribute</div>
<div class:list={empty, "on": pairs}>empty dynamic: no attribute</div>
<div class="a  b" id="i" class:list={"c", extra: hidden}>merged static class</div>
<div class:list={"c"} class={extra}>merged dynamic class</div>
<p class:list={named, tags, `<q>&"`}>named types, escaping</p>
<div class:list={"", "  ": pairs}>blank statics</div>
<div class:list={}>empty list</div>
<div class:list={
	"multi",
	"line": hidden,
}>multi-line</div>
<Card title="static" class:list={"card", " card--big "} />
<Card title="dyn" class="first" class:list={"card", "featured": hidden, "no": pairs, extra, tags} />
<Card title="one" class:list={extra} />
