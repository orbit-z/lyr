---
import Badge "./Badge.lyr"

// Video is one kind of item.
type Video struct{ Title string }

type Props struct {
	Status string
	Items  []any
	N      int
	// Pick puts Video in the declaration package.
	Pick *Video
}

func label(s string) string { return "[" + s + "]" }
---
{switch props.Status}
	{/* the badge */}
	{case "draft"}
		<Badge tone="grey">Draft</Badge>
	{case "scheduled", "queued"}
		<Badge tone="blue">Scheduled<Fragment slot="icon">@</Fragment></Badge>
	{default}
		<Badge tone="green">Published</Badge>
{/switch}
{switch s := label(props.Status); s}
	{case "[draft]"}<i>{s} init</i>
	{default}<i>{s}</i>
{/switch}
{switch}
	{case props.N > 10}<b>big</b>
	{case props.N > 0}<b>small {props.N}</b>
	{default}<b>none</b>
{/switch}
<ul>
	{for i, item := range props.Items}
		{switch v := item.(type)}
			{case int}
				<li data-i={i}>int {v + 1}</li>
			{case string}
				<li data-i={i}>string {v}</li>
			{case bool}
				{if v}
					<li>yes</li>
				{else}
					<li>no</li>
				{/if}
			{case Video}
				<li>video {v.Title}</li>
			{case []int}
				{switch len(v)}
					{case 0}<li>empty</li>
					{default}<li>{len(v)} ints</li>
				{/switch}
			{case nil}
				<li>nil</li>
			{default}
				<li>other {v}</li>
		{/switch}
	{/for}
</ul>
{if props.N > 0}
	{switch props.N % 2}
		{case 0}<p>even</p>
		{case 1}<p>odd</p>
	{/switch}
{/if}
