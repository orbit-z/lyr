---
import Comments "../components/Comments.lyr"
import Spinner "../components/Spinner.lyr"
---
<main>
  <Comments server:defer client:visible="200px" postID={7}><p slot="fallback">Loading comments…</p></Comments>
  <Comments server:defer postID={8}><p slot="fallback">bare</p></Comments>
  <Comments server:defer client:idle postID={9} />
  <Comments server:defer client:media="(min-width: 900px) and (&quot;x&quot;)" postID={10}><Spinner slot="fallback" /></Comments>
  <Comments server:defer client:load postID={11} />
  <Comments server:defer client:visible><Fragment slot="fallback">{if props == props}<i>maybe</i>{/if}</Fragment></Comments>
</main>
