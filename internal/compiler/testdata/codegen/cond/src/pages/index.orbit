---
import Cond "../components/Cond.orbit"
import Button "../components/Button.orbit"
import Mine "../components/Mine.orbit"

on, off := true, false
---
<Cond on rel="noopener" n={3} f={1.5} link="/l" />
<Cond off rel="x" link="javascript:x" />
<Button label={orbit.If(on, "L")} aria-pressed={off} aria-hidden={on} data-x={on} data-y={off} draggable={off} aria-live aria-current={orbit.If(on, "page")} data-gone={orbit.If(off, "no")} />
<Button label={orbit.If(off, "L")} {...orbit.Attrs{"aria-pressed": on, "data-z": on, "spellcheck": off}} />
<Mine />
