---
import (
	"fmt"
	"strings"
)

type Props struct {
	On, Off bool
	Rel     string
	N       int
	F       float64
	Link    string
}

type Flag bool
type Slug string

var order []string
note := func(s string, v bool) bool { order = append(order, s); return v }
val := func(s string) string { order = append(order, s); return s }
var anyv any = 7
data := map[string]int{"a": 1}
---
<a aria-current={orbit.If(props.On, "page")} rel={orbit.If(props.On, props.Rel)} data-off={orbit.If(props.Off, "x<")}>a</a>
<a tabindex={orbit.If(props.On, -1)} data-n={orbit.If(props.On, props.N)} data-f={orbit.If(props.On, props.F)} data-r={orbit.If(props.On, 'r')}>n</a>
<a href={orbit.If(props.On, " JavaScript:alert(1)")} src={orbit.If(props.On, props.Link)} action={orbit.If(props.On, orbit.URL("javascript:ok()"))}>u</a>
<a data-json={orbit.If(props.On, orbit.JSON(data))} data-any={orbit.If(props.On, anyv)} data-slug={orbit.If(props.On, Slug("s&t"))}>j</a>
<button aria-pressed={orbit.If(props.On, props.Off)} aria-hidden={orbit.If(props.On, true)} hidden={orbit.If(props.On, true)} disabled={orbit.If(props.On, props.Off)} data-flag={orbit.If(props.On, Flag(true))}>b</button>
<p>{orbit.If(props.On, "<on>")}|{orbit.If(props.Off, "off")}|{orbit.If(props.On, props.N)}|{orbit.If(props.On, Slug("s"))}|{orbit.If[any](props.On, 3)}|{(orbit.If(props.On, orbit.HTML("<b>h</b>")))}|{orbit.If(props.On, true)}</p>
{for i := range 3}
  <i data-i={orbit.If(i%2 == 0, i)}>{orbit.If(i == 1, props.Rel)}</i>
{/for}
<p title={orbit.If(note("c1", true), val("v1"))}>{orbit.If(note("c2", false), val("v2"))}</p>
<p>{strings.Join(order, ",")}</p>
<p title={fmt.Sprint(orbit.If(props.On, "a"))} {...orbit.Attrs{"data-s": orbit.If(props.On, "s")}}>{[]any{orbit.If(props.On, "x"), "y"}}</p>
<p title={orbit.Cond(props.On, "yes", "no")} aria-selected={orbit.Cond(props.On, "true", "false")}>{orbit.Cond(props.Off, "Saved", "Save")}</p>
<div aria-hidden={props.On} aria-expanded={props.Off} ARIA-Busy={props.On} draggable={props.Off} contenteditable={props.On} spellcheck={props.Off} writingsuggestions={props.On} data-x={props.Off} data-y={props.On} hidden={props.On} popover={props.On} translate={props.On} autocomplete={props.Off}>q3</div>
<div aria-busy={Flag(false)} draggable={true} spellcheck={false} download={props.On}>c</div>
<a download={"file.txt"} hidden={"until-found"} popover={"manual"}>s</a>
<my-el aria-pressed={props.Off} data-x={props.Off} draggable={props.Off} open={props.On}>ce</my-el>
<p {...orbit.Attrs{"aria-pressed": props.Off, "data-x": props.Off, "draggable": true, "hidden": true, "Aria-Live": Flag(false)}}>sp</p>
