---
import (
	"fmt"
	str "strings"
)

type Props struct {
	Body orbit.HTML
	Kind kind
}

type kind = string

const (
	big   = 2
	small = 1
)

func (p Props) Title() string { return str.ToUpper(fmt.Sprint(p.Kind)) }

user := locals.User
---
<div>{props.Title()} {user} {big}</div>
<Fragment set:html={props.Body} />
