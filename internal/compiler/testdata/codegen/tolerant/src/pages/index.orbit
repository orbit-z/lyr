---
import Card "../components/Card.orbit"

post := struct{ Title string }{"t"}
---
<div>{}</div>
<p>{post.Ti}</p>
<Crad title={post.Title} {...post} />
<Card psot={post.Title} title="x" />
<Fragment class={post.Title}>f</Fragment>
{if}
  <b>empty header</b>
{/if}
<div set:html={post.Title}>child {post.Title}</div>
