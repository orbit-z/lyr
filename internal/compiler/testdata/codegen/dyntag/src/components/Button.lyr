---
import "cmp"

type Props struct {
	Variant, Type string
	Attrs         lyr.RestAttrs
}

link := props.Attrs.Has("href")
Tag := lyr.Cond(link, "a", "button")
kind := cmp.Or(props.Type, "button")
---
<Tag {...props.Attrs} type={lyr.If(!link, kind)} class:list={"btn", "btn-" + props.Variant} class="x">
  <slot />
</Tag>
