---
import Box "../components/Box.orbit"
import Button "../components/Button.orbit"
import Choice "../components/Choice.orbit"
import Heading "../components/Heading.orbit"

const Sec = "section"

tags := []string{"em", "strong"}
Item := "li"
List := "ul"
Img := "img"
title := "t"
on := true
attrs := orbit.Attrs{"data-b": 2, "data-a": "1"}
list := orbit.AttrList{orbit.A("data-theme", "dark"), orbit.A("data-n", 3), orbit.A("hidden", on), orbit.A("data-off", false), orbit.A("href", "javascript:x()")}
---
<Sec class="s" {title} data-on={on} aria-busy={on}>
  {for _, T := range tags}<T>{T}</T>{/for}
  <List>{for _, s := range tags}<Item {...attrs}>{s}</Item>{/for}</List>
  <Img src="/a.png" alt="a" />
  <Sec />
  <Sec set:html={"<b>raw</b>"} />
  <Sec set:text={"<b>text</b>"} />
  <Sec {...list}></Sec>
  <p {...list} {...attrs}>static</p>
  <Box><Sec slot="head">head</Sec>body</Box>
</Sec>
<Button variant="primary">Save</Button>
<Button variant="link" href="/x" {...list}>Go</Button>
<Heading level={2} text="Two" />
<Heading level={3} text="Three" />
<Choice wrapped label="w" class="c" />
<Choice label="bare" class="c" />
