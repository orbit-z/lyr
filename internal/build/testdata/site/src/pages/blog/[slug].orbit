---
import (
	"net/http"
	"time"

	Base "../../layouts/Base.orbit"
	Comments "../../components/Comments.orbit"
	Share "../../components/Share.orbit"
)

switch params.Slug {
case "nope":
	return orbit.ErrNotFound
case "old":
	return ctx.Redirect("/blog/hello", http.StatusMovedPermanently)
case "boom":
	panic("kaboom")
case "teapot":
	ctx.SetStatus(http.StatusTeapot)
	ctx.Header().Set("X-Fixture", "teapot")
}
---
<Base title={params.Slug}>
  <h1>Post {params.Slug}</h1>
  <Comments server:defer postID={42} since={time.Date(2026, 1, 2, 0, 0, 0, 0, time.UTC)}><p slot="fallback">Loading comments…</p></Comments>
  <Share client:visible="200px" />
</Base>
