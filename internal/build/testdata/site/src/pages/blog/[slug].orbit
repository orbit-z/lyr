---
import (
	"net/http"

	Base "../../layouts/Base.orbit"
)

switch params.Slug {
case "nope":
	return orbit.ErrNotFound
case "old":
	return ctx.Redirect("/blog/hello", http.StatusMovedPermanently)
case "boom":
	panic("kaboom")
case "teapot":
	ctx.SetStatus(http.StatusTeapot)
	ctx.Header().Set("X-Fixture", "teapot")
}
---
<Base title={params.Slug}>
  <h1>Post {params.Slug}</h1>
</Base>
