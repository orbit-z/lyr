---
import (
	"strings"

	DocBody "../components/DocBody.orbit"
	Toc "../components/Toc.orbit"
	Base "../layouts/Base.orbit"
	"github.com/orbit-z/orbit/docs/site/internal/content"
)

docs, err := content.Get()
if err != nil {
	return err
}
page := docs.Page(params.Slug)
if page == nil {
	// /DECISIONS and /Reference/CLI find their page under its lowercase URL.
	if lower := strings.ToLower(params.Slug); lower != params.Slug && docs.Page(lower) != nil {
		return ctx.Redirect("/"+lower, 308)
	}
	return orbit.ErrNotFound
}
if page.Slug == "" {
	return orbit.ErrNotFound // README.md is the home page, at /
}
prev, next := docs.Neighbors(page)
---
<Base title={page.Title} description={page.Summary}>
  <article>
    <DocBody html={page.HTML} client:idle />
  </article>
  <footer class="pager">
    {if prev != nil}
      <a class="prev" href={prev.URL}><small>Previous</small>{prev.Title}</a>
    {/if}
    {if next != nil}
      <a class="next" href={next.URL}><small>Next</small>{next.Title}</a>
    {/if}
  </footer>
  <p class="edit"><a href={content.RepoURL + "docs/" + page.File}>View the source, docs/{page.File}, on GitHub</a></p>
  <Toc slot="aside" headings={page.TOC} />
</Base>

<style>
  .pager {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager small {
    color: var(--muted);
    font-weight: 400;
  }
  .next {
    text-align: right;
    margin-left: auto;
  }
  .edit {
    font-size: 0.85rem;
  }
  .edit a {
    color: var(--muted);
  }
</style>
