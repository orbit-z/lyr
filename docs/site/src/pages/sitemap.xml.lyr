---
import "github.com/orbit-z/lyr/docs/site/internal/content"

// The sitemap needs absolute URLs: without a site URL there's none.
if ctx.Site == nil {
	return lyr.ErrNotFound
}
docs, err := content.Get()
if err != nil {
	return err
}
ctx.Header().Set("Content-Type", "application/xml; charset=utf-8")
ctx.Header().Set("Cache-Control", "public, max-age=3600")
---
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {for _, p := range docs.Pages}
    <url><loc>{ctx.Site.JoinPath(p.URL).String()}</loc></url>
  {/for}
</urlset>
