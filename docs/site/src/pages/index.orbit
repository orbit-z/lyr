---
import (
	"errors"

	Base "../layouts/Base.orbit"
	"github.com/orbit-z/orbit/docs/site/internal/content"
)

docs, err := content.Get()
if err != nil {
	return err
}
home := docs.Page("")
if home == nil {
	return errors.New("docs: no README.md for the home page")
}
---
<Base description={home.Summary}>
  <section class="hero">
    <h1>Orbit</h1>
    <p class="lead">{home.Summary}</p>
    <p class="cta">
      <a class="primary" href="/getting-started">Get started</a>
      <a href="/coming-from-astro">Coming from Astro</a>
    </p>
  </section>
  {for _, g := range docs.Nav}
    <section class="group">
      <h2>{g.Title}</h2>
      <ul class="cards">
        {for _, it := range g.Items}
          <li>
            <a href={it.URL}>
              <strong>{it.Title}</strong>
              {if it.Desc != ""}<span>{it.Desc}</span>{/if}
            </a>
          </li>
        {/for}
      </ul>
    </section>
  {/for}
</Base>

<style>
  .hero {
    padding: 2rem 0 1rem;
  }
  h1 {
    font-size: 2.6rem;
    margin: 0;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 42rem;
  }
  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cta a {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
  }
  .cta .primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
  }
  .group h2 {
    font-size: 1.1rem;
    margin: 2rem 0 0.75rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cards a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    height: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--fg);
    text-decoration: none;
  }
  .cards a:hover {
    border-color: var(--accent);
  }
  .cards span {
    color: var(--muted);
    font-size: 0.88rem;
  }
</style>
