---
type Props struct {
    // HTML is a page rendered from Markdown by internal/content.
    HTML orbit.HTML
}
---
<doc-body class="prose" set:html={props.HTML}></doc-body>

<style>
  .prose { display: block; overflow-wrap: break-word; }
  .prose :global(h1) { font-size: 2.1rem; line-height: 1.2; margin: 0 0 1rem; }
  .prose :global(h2) {
    font-size: 1.45rem;
    margin: 2.5rem 0 0.75rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(h3) { font-size: 1.15rem; margin: 2rem 0 0.5rem; }
  .prose :global(h4) { font-size: 1rem; margin: 1.5rem 0 0.5rem; }
  .prose :global(:is(h1, h2, h3, h4)) { scroll-margin-top: 4.5rem; }
  .prose :global(.anchor) {
    margin-left: 0.4rem;
    color: var(--muted);
    text-decoration: none;
    opacity: 0;
  }
  .prose :global(:is(h1, h2, h3, h4):hover .anchor),
  .prose :global(.anchor:focus) { opacity: 1; }
  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--code-bg);
  }
  .prose :global(figure.code) {
    position: relative;
    margin: 1rem 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--code-bg);
    overflow: hidden;
  }
  .prose :global(figcaption) {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.35rem 0.85rem;
    border-bottom: 1px solid var(--border);
    font: 0.8rem ui-monospace, monospace;
    color: var(--muted);
  }
  .prose :global(.badge) {
    padding: 0 0.4rem;
    border-radius: 4px;
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
  }
  .prose :global(.badge-expect-error) { background: #fde2e1; color: #a1251b; }
  .prose :global(.badge-expect-warning) { background: #fdf0d2; color: #8a5a00; }
  .prose :global(pre) {
    margin: 0;
    padding: 0.85rem 1rem;
    overflow-x: auto;
    line-height: 1.5;
    tab-size: 4;
  }
  .prose :global(.copy) {
    position: absolute;
    top: 0.35rem;
    right: 0.4rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg);
    color: var(--muted);
    font: 0.75rem system-ui, sans-serif;
    cursor: pointer;
    opacity: 0;
  }
  .prose :global(figure.code:hover .copy),
  .prose :global(.copy:focus) { opacity: 1; }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.92rem;
  }
  .prose :global(:is(th, td)) {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) { background: var(--bg-soft); }
  .prose :global(blockquote) {
    margin: 1rem 0;
    padding: 0.25rem 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .prose :global(details) {
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .prose :global(summary) { cursor: pointer; }
  .prose :global(img) { max-width: 100%; }
</style>

<script>
  // Adds a "Copy" button to every code block of the page.
  class DocBody extends HTMLElement {
    connectedCallback() {
      for (const fig of this.querySelectorAll<HTMLElement>("figure.code")) {
        const code = fig.querySelector("code");
        if (!code || fig.querySelector(".copy")) continue;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy";
        button.textContent = "Copy";
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(code.textContent ?? "");
            button.textContent = "Copied";
          } catch {
            button.textContent = "Failed";
          }
          setTimeout(() => { button.textContent = "Copy"; }, 1500);
        });
        fig.append(button);
      }
    }
  }
  customElements.define("doc-body", DocBody);
</script>
