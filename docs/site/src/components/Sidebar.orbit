---
import "github.com/bertrandkhe/orbit/docs/site/internal/content"

type Props struct {
    Nav []content.NavGroup
    // Current is the path of the page being shown; its link is highlighted.
    Current string
    // Label is the name of the nav landmark.
    Label string
}

// current is the aria-current value of a link: "page" for the current
// page, nil (no attribute) for the others.
current := func(url string) any {
    if url == props.Current {
        return "page"
    }
    return nil
}
---
<nav class="sidebar" aria-label={props.Label}>
  {for _, g := range props.Nav}
    <h2>{g.Title}</h2>
    <ul>
      {for _, it := range g.Items}
        <li><a href={it.URL} aria-current={current(it.URL)}>{it.Title}</a></li>
      {/for}
    </ul>
  {/for}
</nav>

<style>
  .sidebar { font-size: 0.9rem; }
  h2 {
    margin: 1.25rem 0 0.35rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
  }
  h2:first-child { margin-top: 0; }
  ul { list-style: none; margin: 0; padding: 0; }
  a {
    display: block;
    padding: 0.2rem 0.6rem;
    border-radius: 5px;
    color: var(--fg);
    text-decoration: none;
  }
  a:hover { background: var(--bg-soft); }
  a[aria-current="page"] {
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 600;
  }
</style>
