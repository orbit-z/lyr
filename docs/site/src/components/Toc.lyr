---
import "github.com/orbit-z/lyr/docs/site/internal/content"

type Props struct {
	Headings []content.Heading
}
---
{if len(props.Headings) > 0}
  <toc-spy>
  <nav class="toc" aria-label="On this page">
    <h2>On this page</h2>
    <ul>
      {for _, h := range props.Headings}
        <li data-level={h.Level}><a href={"#" + h.ID}>{h.Text}</a></li>
      {/for}
    </ul>
    <p class="top"><a href="#">Back to top</a></p>
  </nav>
  </toc-spy>
{/if}

<style>
  toc-spy {
    display: block;
  }
  h2 {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    margin: 0.2rem 0;
  }
  li[data-level="3"] {
    padding-left: 0.85rem;
  }
  a {
    color: var(--muted);
    text-decoration: none;
  }
  a:hover,
  a.current {
    color: var(--accent);
  }
  a.current {
    font-weight: 600;
  }
  .top {
    margin: 1rem 0 0;
    font-size: 0.8rem;
  }
</style>

<script>
  // Highlights the link of the section being read: the last heading
  // above the top quarter of the viewport.
  class TocSpy extends HTMLElement {
    connectedCallback() {
      const links = [
        ...this.querySelectorAll<HTMLAnchorElement>(
          'a[href^="#"]:not([href="#"])',
        ),
      ];
      const targets = links
        .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
        .filter((h): h is HTMLElement => h !== null);
      if (targets.length === 0) return;
      let frame = 0;
      const update = () => {
        frame = 0;
        const line = innerHeight / 4;
        let i = 0;
        while (
          i + 1 < targets.length &&
          targets[i + 1].getBoundingClientRect().top <= line
        )
          i++;
        if (targets[0].getBoundingClientRect().top > line) i = -1;
        links.forEach((a, j) => a.classList.toggle("current", j === i));
      };
      addEventListener(
        "scroll",
        () => (frame ||= requestAnimationFrame(update)),
        { passive: true },
      );
      update();
    }
  }
  customElements.define("toc-spy", TocSpy);
</script>
