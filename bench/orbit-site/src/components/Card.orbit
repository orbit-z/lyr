---
import Badge "./Badge.orbit"

type Props struct {
    Title    string
    Href     string
    Likes    int
    Featured bool
    Tags     []string
}
---
<article class="card" data-featured={props.Featured}>
  <h2 class="title"><a href={props.Href}>{props.Title}</a></h2>
  <div class="body"><slot /></div>
  <p class="meta">
    <span class="likes">{props.Likes} likes</span>
    {for _, t := range props.Tags}
      {" "}<Badge label={t} />
    {/for}
    {if props.Featured}
      {" "}<strong class="featured">Featured</strong>
    {/if}
  </p>
</article>
<style>
  .card { border: 1px solid #ccc; border-radius: .5rem; padding: 1rem; margin: .5rem 0; }
  .card[data-featured] { border-color: gold; }
  .title { margin: 0 0 .5rem; font-size: 1.1rem; }
  .meta { color: #555; font-size: .9rem; }
</style>
