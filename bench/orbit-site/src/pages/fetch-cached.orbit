---
import (
    "time"

    "example.com/orbitbench/internal/data"
    Layout "../layouts/Layout.orbit"
    ItemList "../components/ItemList.orbit"
)

// The fetch page, stored by the route cache: fresh for an hour, so a
// benchmark run measures cache hits.
items := data.Fetch()
ctx.Cache().Set(orbit.CacheOptions{MaxAge: time.Hour})
---
<Layout title="Fetched list">
  <h1>Latest items</h1>
  <ItemList items={items} />
</Layout>
