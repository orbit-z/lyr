---
import (
    Layout "../layouts/Layout.orbit"
    SlowList "../components/SlowList.orbit"
)
---
<Layout title="Fetched list (deferred)">
  <h1>Latest items</h1>
  <SlowList server:defer>
    <p slot="fallback" class="loading">Loading items…</p>
  </SlowList>
</Layout>
<style>
  .loading { color: #888; }
</style>
