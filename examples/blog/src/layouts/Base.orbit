---
import Header "../components/Header.orbit"

type Props struct {
	Title string
}
---
<!DOCTYPE html>
<html lang="en" data-theme={locals.Theme}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/favicon.svg">
    <title>{props.Title} · Orbit blog</title>
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer>Rendered by Orbit, request <code>{locals.RequestID}</code></footer>
  </body>
</html>
<style>
  main {
    max-width: 40rem;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  footer {
    max-width: 40rem;
    margin: 3rem auto 1rem;
    padding: 0 1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
</style>
<style is:global>
  :root {
    --bg: #fff;
    --fg: #1d1d1f;
    --muted: #6e6e73;
    --border: #ddd;
    --accent: #0b57d0;
  }
  html[data-theme="dark"] {
    --bg: #161618;
    --fg: #f2f2f2;
    --muted: #a1a1a6;
    --border: #3a3a3c;
    --accent: #8ab4f8;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }
  a {
    color: var(--accent);
  }
</style>
