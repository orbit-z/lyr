---
import (
	CommentList "./CommentList.lyr"
	"example.com/blog/internal/posts"
)

type Props struct {
	PostID int
}

// Slow: the post page renders this component with server:defer, fetched
// when it comes within 200px of the viewport (client:visible="200px").
comments, err := posts.Comments(props.PostID)
if err != nil {
	return err
}
---
<section class="comments">
  <h2>Comments</h2>
  <CommentList comments={comments} />
</section>
<style>
  .comments {
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
