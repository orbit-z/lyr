---
type Props struct {
    Slug  string
    Likes int
}
---
<like-button data-slug={props.Slug} data-likes={props.Likes}>
  <button type="button" class="like">♥ <span>{props.Likes}</span></button>
</like-button>
<style>
  .like {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: none;
    color: inherit;
    cursor: pointer;
  }
</style>
<script>
  import { plural } from "../scripts/util";

  // POST /blog/{slug}/like is a custom route in cmd/server: it answers with
  // a freshly rendered LikeButton, which replaces this one.
  class LikeButton extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector("button")!;
      button.title = plural(Number(this.dataset.likes ?? 0), "like");
      button.addEventListener("click", () => this.like(), { once: true });
    }

    async like(): Promise<void> {
      const res = await fetch(`/blog/${this.dataset.slug}/like`, { method: "POST" });
      if (res.ok) {
        this.outerHTML = await res.text();
      }
    }
  }
  customElements.define("like-button", LikeButton);
</script>
