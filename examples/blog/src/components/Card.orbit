---
import "example.com/blog/internal/posts"

type Props struct {
	Post posts.Post
}

href := "/blog/" + props.Post.Slug
---
<article class="card">
  <h2><a href={href}>{props.Post.Title}</a></h2>
  <p class="meta">
    <time datetime={props.Post.Published.Format("2006-01-02")}>{props.Post.Published.Format("2 Jan 2006")}</time>
    {for _, tag := range props.Post.Tags}
      <span class="tag">{tag}</span>
    {/for}
  </p>
  <slot />
</article>
<style>
  .card {
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .card:hover {
    border-color: var(--muted);
  }
  h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
  }
  h2 a {
    color: inherit;
    text-decoration: none;
  }
  .meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .tag {
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--border);
  }
</style>
