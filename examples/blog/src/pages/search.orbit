---
import (
    "example.com/blog/internal/posts"
    Base "../layouts/Base.orbit"
    Card "../components/Card.orbit"
)

q := ctx.Request.URL.Query().Get("q")
results := posts.Search(q)

// Every title, for the search box's suggestions (see the script below).
all, err := posts.All()
if err != nil {
    return err
}
titles := make([]string, len(all))
for i, p := range all {
    titles[i] = p.Title
}
---
<Base title="Search">
  <h1>Search</h1>
  <form action="/search" role="search">
    <input type="search" name="q" value={q} list="post-titles" placeholder="go, security, …" aria-label="Search posts">
    <datalist id="post-titles"></datalist>
    <button type="submit">Search</button>
  </form>
  {if q == ""}
    <p>Type something to search.</p>
  {else if len(results) == 0}
    <p>No posts match <strong>{q}</strong>.</p>
  {else}
    <p>Results for <strong>{q}</strong>:</p>
    {for _, post := range results}
      <Card post={post} />
    {/for}
  {/if}
  <script type="application/json" id="post-titles-data" set:json={titles}></script>
</Base>
<style>
  form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  input { flex: 1; }
</style>
<script>
  // Fill the search box's suggestions from the set:json block above.
  const data = document.getElementById("post-titles-data");
  const list = document.getElementById("post-titles");
  if (data && list) {
    const titles: string[] = JSON.parse(data.textContent ?? "[]");
    for (const title of titles) {
      const option = document.createElement("option");
      option.value = title;
      list.append(option);
    }
  }
</script>
