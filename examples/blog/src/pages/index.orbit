---
import (
    "example.com/blog/internal/posts"
    Base "../layouts/Base.orbit"
    Card "../components/Card.orbit"
)

all, err := posts.All()
if err != nil {
    return err
}
---
<Base title="Posts">
  <script type="application/ld+json" slot="head">{"@context":"https://schema.org","@type":"Blog","name":"Orbit blog"}</script>
  <h1>Posts</h1>
  {for _, post := range all}
    <Card post={post}>
      <p>{post.Summary}</p>
    </Card>
  {/for}
</Base>
<style>
  h1 { margin-top: 0; }
</style>
