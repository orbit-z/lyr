---
import (
	Card "../components/Card.lyr"
	Intro "../content/intro.md"
	Base "../layouts/Base.lyr"
	"example.com/blog/internal/posts"
)

all, err := posts.All()
if err != nil {
	return err
}
---
<Base title="Posts">
  <script type="application/ld+json" slot="head">{"@context":"https://schema.org","@type":"Blog","name":"Lyr blog"}</script>
  <h1>Posts</h1>
  <p class="tagline">{Intro.Frontmatter.Tagline}</p>
  <div class="intro"><Intro /></div>
  {for _, post := range all}
    <Card post={post}>
      <p>{post.Summary}</p>
    </Card>
  {/for}
</Base>
<style>
  h1 {
    margin-top: 0;
  }
</style>
