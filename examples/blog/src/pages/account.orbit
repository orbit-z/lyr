---
import Base "../layouts/Base.orbit"
---
<Base title="Your account">
  <h1>Your account</h1>
  <p>Theme: <strong class="theme">{locals.Theme}</strong></p>
  <p>Request ID: <code>{locals.RequestID}</code></p>
  <p>Both come from the <code>requestInfo</code> middleware in <code>cmd/server/main.go</code>, through typed locals.</p>
  <theme-picker>
    <button type="button" data-theme="light">Light</button>{" "}
    <button type="button" data-theme="dark">Dark</button>
  </theme-picker>
</Base>
<style>
  theme-picker {
    display: flex;
    gap: 0.5rem;
  }
</style>
<script>
  // Store the theme in a cookie and reload, so the server renders it.
  class ThemePicker extends HTMLElement {
    connectedCallback(): void {
      for (const button of this.querySelectorAll<HTMLButtonElement>(
        "button[data-theme]",
      )) {
        button.addEventListener("click", () => {
          document.cookie = `theme=${button.dataset.theme}; path=/; max-age=31536000; samesite=lax`;
          location.reload();
        });
      }
    }
  }
  customElements.define("theme-picker", ThemePicker);
</script>
